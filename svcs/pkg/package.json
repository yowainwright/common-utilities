{
  "name": "@common-utilities/pkg",
  "version": "0.0.1",
  "description": "Manages common-utilities package lifecycle operations.",
  "author": "Jeff Wainwright <https://jeffry.in> (yowainwright@gmail.com)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "pkg": "./dist/cli/index.js",
    "new-u": "./dist/cli/index.js",
    "create-pkg": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "mcp": "node dist/mcp/index.js",
    "test": "pnpm run test:unit",
    "test:unit": "node --test --experimental-strip-types \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.15.29"
  }
}
