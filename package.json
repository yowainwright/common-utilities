{
  "name": "@common-utilities/root",
  "version": "0.0.1",
  "description": "Common utilities for javascript development 🧰",
  "repository": "git@github.com:yowainwright/common-utilities.git",
  "author": "Jeff Wainwright <yowainwright@gmail.com> (https://jeffry.in)",
  "license": "MIT",
  "main": "README.md",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/format": "^21.2.2",
    "@commitlint/prompt": "21.2.2",
    "@common-utilities/api": "workspace:*",
    "@common-utilities/pkg": "workspace:*",
    "@types/node": "26.2.0",
    "codependence": "^1.0.12",
    "commitizen": "4.3.2",
    "eslint-plugin-legibility": "^0.3.3",
    "oxlint": "^1.79.0",
    "pastoralist": "1.13.1",
    "ts-toolbelt": "^9.6.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "pnpm --filter './u/**' --filter './svcs/pkg' --filter './svcs/api' run build",
    "build:api": "pnpm --filter @common-utilities/api build",
    "dev": "pnpm run build:api && mprocs --config ops/mprocs.yaml",
    "dev:api": "pnpm --filter @common-utilities/api serve",
    "dev:mcp": "pnpm --filter @common-utilities/pkg mcp",
    "pkg": "node node_modules/@common-utilities/pkg/dist/cli/index.js",
    "new-u": "pnpm run pkg",
    "create-pkg": "pnpm run pkg",
    "ci": "pnpm run lint:ci && pnpm run test:ci",
    "commit-msg": "commitlint --edit $1",
    "lint": "pnpm run lint:oxlint --fix",
    "lint:ci": "pnpm run lint:oxlint",
    "lint:oxlint": "oxlint -c .oxlintrc.json .",
    "lint:shell": "shellcheck-legibility check scripts",
    "test": "pnpm test:cmd",
    "test:all": "pnpm run test:cmd && pnpm run test:e2e",
    "test:ci": "pnpm test:cmd",
    "test:cmd": "pnpm run test:unit && pnpm run test:integration",
    "test:e2e": "sh ops/test-e2e.sh",
    "test:integration": "pnpm --filter @common-utilities/api test:integration",
    "test:unit": "node --test --experimental-strip-types \"u/**/src/*.test.ts\" && pnpm --filter @common-utilities/pkg test && pnpm --filter @common-utilities/api test",
    "commit": "git-cz",
    "commit:retry": "git-cz --retry",
    "setup": "sh scripts/setup.sh",
    "deploy": "pnpm build && pnpm -r publish",
    "prepublishOnly": "pnpm build",
    "release-prep": "changeset",
    "release-bumps": "changeset version",
    "release-packages": "pnpm prepublishOnly && changeset publish && git push --follow-tags",
    "update": "codependence --update",
    "check-deps": "pastoralist --debug"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        120
      ],
      "scope-enum": [
        2,
        "always",
        [
          "api",
          "curry",
          "root",
          "pkg",
          "ops",
          "compose",
          "debounce",
          "head",
          "pipe",
          "repeat",
          "trace",
          "filter-array",
          "merge-objects",
          "is-object",
          "string-interpolation",
          "kebab-to-camel-string",
          "throttle",
          "trim-whitespace",
          "wait-until-defined",
          "rot13",
          "snake-to-camel-string"
        ]
      ],
      "type-enum": [
        2,
        "always",
        [
          "chore",
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "test",
          "release",
          "revert"
        ]
      ]
    }
  },
  "pastoralist": {
    "appendix": {
      "minimist@^1.2.6": {
        "dependents": {
          "typescript": "minimist@^1.2.8"
        }
      }
    }
  }
}
